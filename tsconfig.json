/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "verbatimModuleSyntax": true,
    "types": [
      "angular8-yandex-maps"
    ],
    "lib": [
      "ES2022",
      "dom"
    ],
    "baseUrl": "./",
    "paths": {
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@utils/*": [
        "src/app/utils/*"
      ],
      "@delivery": [
        "./src/app/features/delivery/index.ts"
      ],
      "@delivery/*": [
        "./src/app/features/delivery/*"
      ],
      "@auth": [
        "./src/app/features/auth/index.ts"
      ],
      "@auth/*": [
        "./src/app/features/auth/*"
      ],
      "@account": [
        "./src/app/features/account/index.ts"
      ],
      "@account/*": [
        "./src/app/features/account/*"
      ],
      "@tariffs": [
        "./src/app/features/tariffs/index.ts"
      ],
      "@tariffs/*": [
        "./src/app/features/tariffs/*"
      ],
      "@services": [
        "./src/app/features/services/index.ts"
      ],
      "@services/*": [
        "./src/app/features/services/*"
      ],
      "@info": [
        "./src/app/features/info/index.ts"
      ],
      "@info/*": [
        "./src/app/features/info/*"
      ],
      "@tracking": [
        "./src/app/features/tracking/index.ts"
      ],
      "@tracking/*": [
        "./src/app/features/tracking/*"
      ],
      "@contacts": [
        "./src/app/features/contacts/index.ts"
      ],
      "@contacts/*": [
        "./src/app/features/contacts/*"
      ],
      "@news": [
        "./src/app/features/news/index.ts"
      ],
      "@news/*": [
        "./src/app/features/news/*"
      ],
      "@env/*": [
        "src/environments/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
