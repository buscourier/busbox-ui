{
  "name": "busbox-ui",
  "version": "1.0.0",
  "description": "Starter template for Angular project with NgRx and Tailwind CSS",
  "author": "Anton Maiatskii <work.mayatskiy@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buscourier/busbox-ui"
  },
  "keywords": [
    "angular",
    "starter",
    "ngrx",
    "tailwind"
  ],
  "homepage": "https://busbox-ui.dev",
  "bugs": {
    "url": "https://github.com/buscourier/busbox-ui/issues"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "prepare": "husky",
    "serve:ssr:busbox-ui": "node dist/busbox-ui/server/server.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,scss}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
