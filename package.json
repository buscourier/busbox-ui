{
  "name": "busbox-ui",
  "version": "1.0.0",
  "description": "Starter template for Angular project with NgRx and Tailwind CSS",
  "author": "Anton Maiatskii <work.mayatskiy@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/buscourier/busbox-ui"
  },
  "keywords": [
    "angular",
    "starter",
    "ngrx",
    "tailwind"
  ],
  "homepage": "https://busbox-ui.dev",
  "bugs": {
    "url": "https://github.com/buscourier/busbox-ui/issues"
  },
  "engines": {
    "node": ">=20.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,scss}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.1.4",
    "@angular/cdk": "^19.0.0",
    "@angular/common": "^19.1.4",
    "@angular/compiler": "^19.1.4",
    "@angular/core": "^19.1.4",
    "@angular/forms": "^19.1.4",
    "@angular/platform-browser": "^19.1.4",
    "@angular/platform-browser-dynamic": "^19.1.4",
    "@angular/router": "^19.1.4",
    "@jsverse/transloco": "^7.6.1",
    "@ngrx/effects": "^19.0.1",
    "@ngrx/entity": "^19.0.1",
    "@ngrx/operators": "^19.0.1",
    "@ngrx/router-store": "^19.0.1",
    "@ngrx/store": "^19.0.1",
    "@ngrx/store-devtools": "^19.0.1",
    "@taiga-ui/addon-commerce": "^4.31.0",
    "@taiga-ui/addon-mobile": "^4.31.0",
    "@taiga-ui/addon-table": "^4.31.0",
    "@taiga-ui/cdk": "^4.31.0",
    "@taiga-ui/core": "^4.31.0",
    "@taiga-ui/event-plugins": "^4.5.0",
    "@taiga-ui/icons": "^4.31.0",
    "@taiga-ui/kit": "^4.31.0",
    "@taiga-ui/layout": "^4.31.0",
    "@taiga-ui/legacy": "^4.31.0",
    "@tailwindcss/postcss": "^4.1.3",
    "jwt-decode": "^4.0.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "uuid": "^11.0.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^19.0.0",
    "@angular-devkit/build-angular": "^19.1.5",
    "@angular/cli": "^19.1.5",
    "@angular/compiler-cli": "^19.1.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@ngrx/eslint-plugin": "^19.0.1",
    "@ngrx/schematics": "^19.0.1",
    "@types/jasmine": "~5.1.5",
    "@types/node": "^22.13.0",
    "angular-eslint": "19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv-webpack": "^8.1.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.8.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "husky": "^9.1.7",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^15.4.3",
    "postcss": "^8.5.1",
    "postcss-import": "^16.1.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.22.0"
  }
}
