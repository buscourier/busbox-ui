# Stage 1: Install dependencies
FROM node:20-alpine AS deps

WORKDIR /app

# Copy package.json and package-lock.json files
COPY package*.json ./

# Install all dependencies, including devDependencies
RUN npm ci --legacy-peer-deps

# Stage 2: Development
FROM node:20-alpine

ARG NODE_ENV=development
ENV NODE_ENV=$NODE_ENV

# Remove API secrets from build args - they should be runtime secrets
# Add SSR_BASE_URL for consistency (though not used in ng serve)
ENV SSR_BASE_URL=http://localhost:4200

WORKDIR /app

# Copy installed dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy source code
COPY . .

# Expose dev server port
EXPOSE 4200

# Run the application in development mode with ng serve
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]
